                  "//Random ISBN Each Time",
                  "let jsonData = pm.response.json();",
                  "let randomBook = jsonData.books[Math.floor(Math.random() * jsonData.books.length)];",
                  "pm.environment.set(\"isbn\", randomBook.isbn);",
                  "console.log(\"selected Book\", randomBook.title); ",
                  "console.log(\"ISBN\", randomBook.isbn); "
